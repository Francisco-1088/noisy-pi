{
  "name": "noisy-multiface",
  "version": "1",
  "category": "traffic",
  "description": "Web browsing noise as one of seven client identities in turn: the Pi on eth0, a MacBook and a Windows PC on tagged VLANs, an iPhone and a Galaxy (WPA2-PSK, WPA3-SAE or OWE) on wlan0, plus two 802.1X (EAP-TTLS) SSIDs as a chosen device. Spoofed MAC, DHCP hostname and User-Agent.",
  "entrypoint": "pimgr_run.sh",
  "requires_root": true,
  "timeout_s": 7800,
  "requires": {
    "commands": ["nmcli", "ip"]
  },
  "params": {
    "slot": {"type": "enum", "choices": ["next", "1", "2", "3", "4", "5", "6", "7"], "default": "next"},
    "slots": {"type": "string", "default": "1-7"},
    "duration_s": {"type": "int", "min": 60, "max": 7200, "default": 900},
    "vlan_a": {"type": "int", "min": 1, "max": 4094, "default": 3},
    "vlan_b": {"type": "int", "min": 1, "max": 4094, "default": 4},
    "ssid_sae": {"type": "string", "default": "1Meter-SE-Labs-Spoke-1"},
    "ssid_owe": {"type": "string", "default": "1Meter-Spoke-1-Guest"},
    "owe_hidden": {"type": "bool", "default": true},
    "psk_security": {"type": "enum", "choices": ["wpa-psk", "sae"], "default": "wpa-psk"},
    "guest_security": {"type": "enum", "choices": ["wpa-psk", "sae", "owe"], "default": "wpa-psk"},
    "ssid_nac": {"type": "string", "default": "", "allow_empty": true},
    "nac_user": {"type": "string", "default": "", "allow_empty": true},
    "ssid_3pr": {"type": "string", "default": "", "allow_empty": true},
    "tpr_user": {"type": "string", "default": "", "allow_empty": true},
    "eap_device": {"type": "enum", "choices": ["macbook", "windows", "galaxy", "iphone"], "default": "macbook"},
    "users": {"type": "int", "min": 1, "max": 20, "default": 3},
    "threads": {"type": "int", "min": 1, "max": 20, "default": 5},
    "min_sleep": {"type": "float", "min": 0.5, "max": 120, "default": 3},
    "max_sleep": {"type": "float", "min": 1, "max": 600, "default": 20},
    "dns_workers": {"type": "int", "min": 0, "max": 10, "default": 2},
    "sites": {"type": "int", "min": 100, "max": 10000, "default": 2000},
    "show_urls": {"type": "bool", "default": false}
  }
}
